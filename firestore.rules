rules_version = '2';

// Egtma3 security rules — free Spark plan edition (no Cloud Functions).
//
// The app itself maintains summaries (absence streaks, suggestions, meeting
// counters, notifications), so these rules allow exactly those writes and
// nothing more:
//  * roles live in users/{uid}.role and only the father can change them;
//  * every active servant has full women CRUD (create / update / delete /
//    activate) — not father-only; there is NO per-meeting / per-conference /
//    per-افتقاد assignment — the ONLY assignment is street.servantId
//    (managed on the Streets screen): every woman belongs to her street's
//    servant; servants may also create conferences and import/export;
//    managing users, streets (screen) and settings stays father-only;
//  * history (follow_ups, audit_logs) is append-only;
//  * notifications can be created once but never overwritten (de-duplication).
//
// JOIN CODE (كود الانضمام): anyone can create an account from the app, but
// the profile is accepted only with the code in `joinCode()` below — the same
// approach as eftekad_app. The code lives only here (server side), not in the
// app. To change it: edit joinCode() and run
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function joinCode() { return '897373'; }

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function userDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function me() { return get(userDoc()).data; }
    function isActive() { return signedIn() && exists(userDoc()) && me().active == true; }
    function isFather() { return isActive() && me().role == 'father'; }
    function isServant() { return isActive() && me().role == 'servant'; }
    function womanPath(id) { return /databases/$(database)/documents/women/$(id); }
    // Assignment to a servant is optional and informational: every active
    // servant may work on every existing woman.
    function staffFor(womanId) { return isActive() && exists(womanPath(womanId)); }
    function changes() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyChanges(keys) { return changes().hasOnly(keys); }
    function isStatus(s) { return s == 'present' || s == 'absent'; }
    function str(v, max) { return v is string && v.size() <= max; }
    // ---------- users ----------
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isActive();
      // Self sign-up: only your own profile, only with the right join code.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.code == joinCode()
        && request.resource.data.role in ['servant', 'father']
        && request.resource.data.active == true
        && str(request.resource.data.name, 120) && request.resource.data.name.size() >= 3;
      // Users may edit their own preferences; the father edits others
      // (including role/active) but never his own role/active.
      allow update: if (signedIn() && request.auth.uid == uid
          && onlyChanges(['notificationPrefs', 'textScale', 'fcmTokens', 'updatedAt']))
        || (isFather() && request.auth.uid != uid
          && request.resource.data.role in ['father', 'servant']);
      allow delete: if false;
    }

    // ---------- women: full CRUD for every active servant ----------
    // The only assignment is by street (streets/{id}.servantId).
    function summaryFields() {
      return ['consecutiveAbsences', 'totalPresent', 'totalAbsent', 'lastAttendanceDate',
              'activeSuggestionType', 'phoneCalls', 'homeVisits', 'lastCallAt', 'lastVisitAt',
              'notes', 'updatedAt'];
    }
    // Full create/update form fields (servants and father alike).
    function womanFormValid() {
      return str(request.resource.data.fullName, 200)
        && request.resource.data.fullName.size() >= 3
        && str(request.resource.data.phone, 20)
        && request.resource.data.active is bool
        && (!('notes' in request.resource.data) || str(request.resource.data.notes, 2000));
    }
    match /women/{id} {
      allow read: if isActive();
      allow create: if isActive() && womanFormValid();
      // request.resource.data is the future full document, so the form check
      // passes for partial updates too (activate, counters, notes).
      allow update: if isActive() && (
        womanFormValid()
        || onlyChanges(['active', 'updatedAt'])
        || (isServant() && onlyChanges(summaryFields()))
      );
      allow delete: if isActive();
    }

    match /streets/{id} {
      allow read: if isActive();
      // Servants create/update streets implicitly when adding or editing a
      // woman (street upsert); the Streets management screen stays
      // father-only in the app. Deleting a street stays father-only.
      // Assigning a servant to a street (the only assignment) is father-only.
      allow create: if isActive() && str(request.resource.data.name, 120)
        && (isFather() || !request.resource.data.keys().hasAny(['servantId', 'servantName']));
      allow update: if isActive() && str(request.resource.data.name, 120)
        && (isFather() || !changes().hasAny(['servantId', 'servantName']));
      allow delete: if isFather();
    }

    // ---------- Wednesday attendance ----------
    // Deterministic id {meetingId}_{womanId} prevents duplicates.
    match /attendance/{id} {
      allow read: if isActive();
      allow create, update: if id == request.resource.data.meetingId + '_' + request.resource.data.womanId
        && request.resource.data.meetingId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isStatus(request.resource.data.status)
        && request.resource.data.markedBy == request.auth.uid
        && staffFor(request.resource.data.womanId);
      // servantId = the street's servant at mark time (for statistics).
      allow update: if isFather() && onlyChanges(['servantId']);
      allow delete: if isActive();
    }

    // Dashboard counters, incremented by the app together with each mark.
    // autoAbsentDone flags that unmarked women were auto-marked absent
    // (Wednesday 9pm cutoff).
    match /meetings/{id} {
      allow read: if isActive();
      allow write: if isActive() && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['present', 'absent', 'byStreet', 'byServant', 'updatedAt', 'autoAbsentDone']);
      allow delete: if isFather();
    }

    // ---------- follow-ups ----------
    match /follow_ups/{id} {
      allow read: if isActive();
      allow create: if request.resource.data.servantId == request.auth.uid
        && request.resource.data.type in ['phone_call', 'home_visit', 'note']
        && str(request.resource.data.notes, 2000)
        && staffFor(request.resource.data.womanId);
      // History is immutable; only the father may move it to a new servant.
      allow update: if isFather() && onlyChanges(['assignedServantId']);
      allow delete: if isFather();
    }

    // Suggestions are created by the app's rules engine with deterministic
    // ids ({womanId}_{type}_{streakStart}); staff may then change status.
    // The assignee always mirrors the woman's street servant (the ONLY
    // assignment); only the father may move a task to another servant.
    function suggStatusOk() {
      return request.resource.data.status in ['pending', 'assigned', 'in_progress', 'completed', 'dismissed', 'cancelled'];
    }
    function suggProgressFields() {
      return ['status', 'updatedAt', 'completedAt', 'completedBy', 'followUpId', 'cancelReason'];
    }
    match /follow_up_suggestions/{id} {
      allow read: if isActive();
      allow create: if staffFor(request.resource.data.womanId)
        && id == request.resource.data.womanId + '_' + request.resource.data.type + '_' + request.resource.data.streakStartMeetingId
        && request.resource.data.type in ['phone', 'home_visit']
        && request.resource.data.status == 'pending';
      allow update: if (isFather() && suggStatusOk())
        || (isServant() && suggStatusOk()
          && request.resource.data.status != 'dismissed'
          && onlyChanges(suggProgressFields()));
      allow delete: if isFather();
    }

    // ---------- conferences (servants may create; delete stays father-only) ----------
    match /conferences/{id} {
      allow read: if isActive();
      allow create, update: if isActive() && str(request.resource.data.name, 200)
        && request.resource.data.days is list && request.resource.data.days.size() == 3;
      allow delete: if isFather();
    }

    match /conference_attendance/{id} {
      allow read: if isActive();
      allow create, update: if id == request.resource.data.conferenceId + '_' + request.resource.data.conferenceDayId + '_' + request.resource.data.womanId
        && isStatus(request.resource.data.attendanceStatus)
        && request.resource.data.conferenceDayId in ['day1', 'day2', 'day3']
        && exists(/databases/$(database)/documents/conferences/$(request.resource.data.conferenceId))
        && staffFor(request.resource.data.womanId);
      allow delete: if isFather();
    }

    // ---------- notifications ----------
    // Created by the app; create-only, so an existing id is never overwritten
    // (that rejection is how duplicates are prevented).
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if isActive()
        && str(request.resource.data.recipientId, 128)
        && str(request.resource.data.title, 300)
        && str(request.resource.data.message, 1000)
        && request.resource.data.type in ['attendance', 'follow_up', 'birthday', 'conference', 'system', 'reminder', 'verse']
        && request.resource.data.readAt == null;
      allow update: if signedIn() && resource.data.recipientId == request.auth.uid && onlyChanges(['readAt']);
      allow delete: if isFather();
    }

    // ---------- content & settings ----------
    match /daily_verses/{id} {
      allow read: if isActive();
      allow write: if isFather();
    }
    match /verse_pool/{id} {
      allow read, write: if isFather();
    }
    match /settings/app {
      allow read: if isActive();
      allow write: if isFather();
    }

    // ---------- audit log: append-only ----------
    match /audit_logs/{id} {
      allow read: if isFather();
      allow create: if isActive() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
